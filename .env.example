# NestList Environment Variables - Production Template

# 1. Supabase Backend Integration (Supabase project settings -> API)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# 2. Application Deployment Settings
VITE_APP_URL=https://nestlist.co.ke
CALLBACK_URL=https://nestlist.co.ke/api/mpesa/callback

# 3. Safaricom Daraja M-Pesa Integration Settings
# Set to 'sandbox' for testing, or 'production' for live payments
MPESA_ENV=sandbox
MPESA_KEY=your_safaricom_consumer_key
MPESA_SECRET=your_safaricom_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_mpesa_online_passkey

# 4. Optional Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key

# 5. Callback security (generate a long random string)
CALLBACK_SECRET=your_long_random_string
MPESA_CALLBACK_SECRET=same_value_as_CALLBACK_SECRET   # for Supabase edge functions

# 6. Payments display / admin contact (kept out of source code)
MPESA_PAYBILL=your_paybill_number
MPESA_MANUAL_ACCOUNT=your_manual_payment_account
ADMIN_PHONE=+254XXXXXXXXX

# 7. Outgoing email (Gmail app password or other SMTP provider)
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_app_password

# 8. SMS (Africa's Talking)
AT_API_KEY=your_africastalking_api_key
